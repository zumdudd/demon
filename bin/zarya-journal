#!/usr/bin/env python3
# ДЕМОН · concept + direction: ШУМ (shum) · built with Claude (Anthropic)
# ZARYA ⇢ SLMAEVE :: ДЕМОН's listening journal (j3, mint-pack v26: Spotify history summary, light ДНЕВНИК; j2 mint-pack v18; j1 v17: plays as ПОДМЕНЫШ show as their own mode). Module for zarya-daemon-desk + a CLI.
# j4 (mint-pack v49): ДНЕВНИК shows zarya-mind's reading of each song (what it is about, mood) and the week's read.
# The desktop ДЕМОН writes one line per play: what played, how long you really listened, skipped / finished / replayed,
# ♥, volume changes, the mode + weather he chose and why, his peaks, what hurt him, the ear (BPM, loudness, 808, beat),
# the app in front, Lima weather, hour. You never write a note per song: he asks only about songs you keep playing
# that he still can't read.
#   zarya-journal                today: plays, top songs, skips
#   zarya-journal week | top [DAYS]
#   zarya-journal diary          build + open ДНЕВНИК (interactive page) ~/.local/share/zarya/listening/dnevnik.html
#   zarya-journal ask            songs he would like your feeling about (played ≥ 3×, mode only from the ear)
#   zarya-journal lastfm USER    pull your Last.fm scrobbles (phone, other PCs) into the journal (API key: ~/.config/zarya/lastfm.key)
#   zarya-journal import PATH    Spotify extended streaming history (the zip or its folder, or one .json) → backfill
#   zarya-journal history        your whole Spotify history: hours per year, top artists and songs (j3)
#   zarya-journal export         ~/Downloads/demon-journal-<stamp>.tar.gz (journal + reports) to attach for Claude
#   zarya-journal path
# Files: ~/.local/share/zarya/listening/{plays-YYYY-MM.jsonl, lastfm.jsonl, spotify.jsonl, spotify-summary.json, asked.json, dnevnik.html}
#        ~/.config/zarya/journal.conf  (lastfm_user=…)
import os, sys, json, time, glob, re, math, hashlib, unicodedata, subprocess, collections, calendar

VERSION = 'j4'
RECENT_DAYS = 90                      # j3: ДНЕВНИК keeps single Spotify plays for this long; older = the summary
HOME = os.path.expanduser('~')
DIR = f'{HOME}/.local/share/zarya/listening'
CONF = f'{HOME}/.config/zarya/journal.conf'
ASKED = f'{DIR}/asked.json'
STATUS_JS = os.environ.get('ZARYA_WEATHER_JS', os.path.expanduser('~/.cache/zarya/weather.js'))
LASTFM_API = os.environ.get('ZARYA_LASTFM_API', 'https://ws.audioscrobbler.com')
WMO = {0: 'clear', 1: 'clear', 2: 'cloudy', 3: 'cloudy', 45: 'fog', 48: 'fog', 51: 'drizzle', 53: 'drizzle', 55: 'drizzle', 61: 'rain',
       63: 'rain', 65: 'rain', 80: 'rain', 81: 'rain', 82: 'rain', 95: 'storm', 96: 'storm', 99: 'storm'}


def norm(s):
    s = unicodedata.normalize('NFKD', s or '').encode('ascii', 'ignore').decode() or (s or '')
    return re.sub(r'\s+', ' ', re.sub(r'[^\w\s]', ' ', s.lower())).strip()


def key_of(artist, title):
    t = re.sub(r'\s*[\(\[].*?[\)\]]', '', title or ''); t = re.split(r'\s-\s', t)[0]
    return norm(artist) + '|' + norm(t)


def conf():
    c = {}
    try:
        for ln in open(CONF, encoding='utf-8'):
            m = re.match(r'\s*([a-z_]+)\s*=\s*(.*?)\s*$', ln)
            if m: c[m.group(1)] = m.group(2)
    except OSError: pass
    return c


def lima_weather():
    try:
        txt = open(STATUS_JS, encoding='utf-8').read()
        d = json.loads(txt[txt.index('{'):txt.rindex('}') + 1])
        code = int(d.get('weather', -1)); return dict(code=code, sky=WMO.get(code, 'other'), temp=d.get('temp'))
    except Exception: return None


# ============================================================ the writer (lives inside the desktop ДЕМОН)
class Journal:
    def __init__(self, log=None):
        self.log = log or (lambda m: None); self.cur = None; self.prev_key = None; self.replays = 0
        os.makedirs(DIR, exist_ok=True)

    def start(self, now, meta, player, length):
        artists = meta.get('artists') or []; title = meta.get('title') or ''
        if not title or title == '?': self.cur = None; return
        k = key_of(artists[0] if artists else '', title)
        self.replays = self.replays + 1 if k == self.prev_key else 0
        self.cur = dict(v=1, start=round(now, 1), artists=artists, title=title, album=meta.get('album') or '', player=player,
                        length=round(length or 0, 1), heard=0.0, last=now, playing=None, key=k, replay=self.replays,
                        like=False, vol=0, report=False, peaks=[], hurt=[], apps=collections.Counter(), ear=[], mode=None,
                        weather=None, why=None, hour=time.localtime(now).tm_hour, sky=lima_weather(), pos_end=None, talk=None)

    def tick(self, now, playing, pos=None, mode=None, weather=None, why=None, app=None, sn=None, talk=None):
        c = self.cur
        if not c: return
        if c['playing']: c['heard'] += max(0.0, min(5.0, now - c['last']))
        c['last'] = now; c['playing'] = playing
        if pos is not None and pos > 0: c['pos_end'] = pos
        if mode: c['mode'] = mode
        if weather is not None and why is not None: c['weather'] = weather; c['why'] = why
        if talk is not None: c['talk'] = talk
        if app and playing: c['apps'][app] += 1
        if sn and playing and sn.get('t') and now - sn['t'] < 2:
            c['ear'].append((sn.get('bpm') or 0, sn.get('level') or 0, sn.get('subr') or 0, sn.get('beat') or 0, sn.get('excite') or 0))
            c['ear'] = c['ear'][-400:]

    def mark(self, what, detail=''):
        c = self.cur
        if not c: return
        if what == 'like': c['like'] = True
        elif what == 'vol': c['vol'] += 1
        elif what == 'report': c['report'] = True
        elif what == 'peak': c['peaks'].append(detail[:60]); c['peaks'] = c['peaks'][-30:]
        elif what == 'hurt': c['hurt'].append(detail[:40])

    def end(self, now, reason):
        """reason: next (track changed), stop (player gone / paused long), quit"""
        c = self.cur; self.cur = None
        if not c: return None
        if c['playing']: c['heard'] += max(0.0, min(5.0, now - c['last']))
        L, heard = c['length'], c['heard']
        if L and (heard >= 0.85 * L or (c['pos_end'] or 0) >= L - 12): out = 'finish'
        elif reason == 'next' and heard < 30 and (not L or heard < 0.5 * L): out = 'skip'
        else: out = 'partial'
        if heard < 3 and out != 'skip': return None                      # a blip while switching, not a play
        ear = c['ear']
        def avg(i): return round(sum(e[i] for e in ear) / len(ear), 3) if ear else None
        rec = dict(v=1, ts=c['start'], end=round(now, 1), artist=(c['artists'] or [''])[0], artists=c['artists'], title=c['title'],
                   album=c['album'], key=c['key'], player=c['player'], length=c['length'], heard=round(heard, 1), outcome=out,
                   replay=c['replay'], like=c['like'], vol=c['vol'], report=c['report'], mode=c['mode'], weather=c['weather'],
                   why=c['why'], peaks=c['peaks'], hurt=c['hurt'], app=(c['apps'].most_common(1)[0][0] if c['apps'] else None),
                   hour=c['hour'], sky=c['sky'], talk=c['talk'],
                   ear=dict(bpm=avg(0), level=avg(1), sub=avg(2), beat=avg(3), excite_max=round(max((e[4] for e in ear), default=0), 3)) if ear else None)
        self.prev_key = c['key'] if out != 'skip' else self.prev_key
        try:
            with open(f'{DIR}/plays-{time.strftime("%Y-%m", time.localtime(c["start"]))}.jsonl', 'a', encoding='utf-8') as f:
                f.write(json.dumps(rec, ensure_ascii=False) + '\n')
        except OSError as e: self.log(f'journal: not written: {e}')
        return rec

    # --- ask only when it matters
    def should_ask(self, key, srule, why, hidden):
        if hidden or not key: return False
        if srule and (srule.get('feel') or srule.get('mode')): return False
        if why not in ('the sound', 'listening…', None): return False
        a = asked()
        if key in a.get('songs', {}) or time.time() - a.get('last', 0) < 3600: return False
        n = sum(1 for r in plays(days=60) if r.get('key') == key and r.get('outcome') != 'skip')
        return n >= 3

    def asked(self, key, answer):
        a = asked(); a.setdefault('songs', {})[key] = dict(t=time.time(), answer=answer); a['last'] = time.time()
        try:
            with open(ASKED + '.tmp', 'w', encoding='utf-8') as f: json.dump(a, f, ensure_ascii=False)
            os.replace(ASKED + '.tmp', ASKED)
        except OSError: pass


def asked():
    try: return json.load(open(ASKED, encoding='utf-8'))
    except (OSError, ValueError): return {}


# ============================================================ reading
def plays(days=None, src=('local',)):
    out = []; since = time.time() - days * 86400 if days else 0
    if 'local' in src:
        for p in sorted(glob.glob(f'{DIR}/plays-*.jsonl')):
            for ln in open(p, encoding='utf-8'):
                try: r = json.loads(ln)
                except ValueError: continue
                if r.get('ts', 0) >= since: r['src'] = 'local'; out.append(r)
    for name in ('lastfm', 'spotify'):
        if name in src and os.path.exists(f'{DIR}/{name}.jsonl'):
            for ln in open(f'{DIR}/{name}.jsonl', encoding='utf-8'):
                try: r = json.loads(ln)
                except ValueError: continue
                if r.get('ts', 0) >= since: r['src'] = name; out.append(r)
    out.sort(key=lambda r: r.get('ts', 0))
    return out


def fmt(s):
    s = int(s or 0); return f'{s // 3600}h{s % 3600 // 60:02d}m' if s >= 3600 else f'{s // 60}m{s % 60:02d}s'


def summary(rs, title):
    if not rs: print(f'{title}: nothing yet.'); return
    heard = sum(r.get('heard') or 0 for r in rs)
    sk = sum(1 for r in rs if r.get('outcome') == 'skip')
    print(f'{title}: {len(rs)} plays · {fmt(heard)} listened · {sk} skipped ({100 * sk // max(1, len(rs))}%)')
    top = collections.Counter((r['artist'], r['title']) for r in rs if r.get('outcome') != 'skip').most_common(8)
    for (a, t), n in top: print(f'  {n:3d}×  {t} · {a}')
    modes = collections.Counter(r.get('mode') for r in rs if r.get('mode')).most_common(5)
    if modes: print('  modes: ' + ' · '.join(f'{m} {n}' for m, n in modes))
    hurt = [h for r in rs for h in (r.get('hurt') or [])]
    if hurt: print(f'  he got hurt {len(hurt)}×: ' + ', '.join(collections.Counter(hurt).keys()))


# ============================================================ Last.fm + Spotify backfill
def lastfm_sync(user):
    import urllib.request, urllib.parse
    try: key = open(f'{HOME}/.config/zarya/lastfm.key').read().strip().split()[0]
    except (OSError, IndexError): print('no Last.fm key in ~/.config/zarya/lastfm.key'); return 1
    path = f'{DIR}/lastfm.jsonl'; last = 0
    if os.path.exists(path):
        for ln in open(path, encoding='utf-8'):
            try: last = max(last, json.loads(ln).get('ts', 0))
            except ValueError: pass
    got = []; page = 1
    while page <= 50:
        q = urllib.parse.urlencode(dict(method='user.getrecenttracks', user=user, api_key=key, format='json', limit=200, page=page, **({'from': int(last) + 1} if last else {})))
        try:
            with urllib.request.urlopen(urllib.request.Request(f'{LASTFM_API}/2.0/?{q}', headers={'User-Agent': 'zarya-journal/j1'}), timeout=15) as r: d = json.load(r)
        except Exception as e: print(f'Last.fm: {e}'); break
        if 'error' in d: print(f"Last.fm: {d.get('message')}"); return 1
        tr = d.get('recenttracks', {}).get('track', [])
        if isinstance(tr, dict): tr = [tr]
        for t in tr:
            if (t.get('@attr') or {}).get('nowplaying'): continue
            ts = int((t.get('date') or {}).get('uts') or 0)
            if not ts or ts <= last: continue
            a = (t.get('artist') or {}).get('#text') or ''; ti = t.get('name') or ''
            got.append(dict(v=1, ts=ts, artist=a, artists=[a], title=ti, album=(t.get('album') or {}).get('#text') or '', key=key_of(a, ti), outcome='scrobble'))
        tp = int(d.get('recenttracks', {}).get('@attr', {}).get('totalPages') or 1)
        if page >= tp: break
        page += 1; time.sleep(0.25)
    got.sort(key=lambda r: r['ts'])
    with open(path, 'a', encoding='utf-8') as f:
        for r in got: f.write(json.dumps(r, ensure_ascii=False) + '\n')
    print(f'Last.fm: {len(got)} new scrobbles for {user}'); return 0


def spotify_import(path):
    import zipfile
    files = []
    if os.path.isdir(path): files = [(p, None) for p in glob.glob(f'{path}/**/Streaming_History_Audio*.json', recursive=True)]
    elif path.endswith('.zip'):
        z = zipfile.ZipFile(path); files = [(n, z) for n in z.namelist() if re.search(r'Streaming_History_Audio.*\.json$', n)]
    elif path.endswith('.json'): files = [(path, None)]
    if not files: print('no Streaming_History_Audio_*.json found (request "Extended streaming history" in Spotify > Account > Privacy)'); return 1
    os.makedirs(DIR, exist_ok=True)                                    # j3: works before ДЕМОН ever wrote a play
    seen = set(); outp = f'{DIR}/spotify.jsonl'
    if os.path.exists(outp):
        for ln in open(outp, encoding='utf-8'):
            try: r = json.loads(ln); seen.add((r['ts'], r['key']))
            except (ValueError, KeyError): pass
    n = 0
    with open(outp, 'a', encoding='utf-8') as f:
        for name, z in files:
            data = json.loads(z.read(name).decode('utf-8') if z else open(name, encoding='utf-8').read())
            for e in data:
                a = e.get('master_metadata_album_artist_name'); t = e.get('master_metadata_track_name')
                if not a or not t: continue                                # podcasts / videos
                try: end = calendar.timegm(time.strptime(e['ts'], '%Y-%m-%dT%H:%M:%SZ'))
                except (KeyError, ValueError): continue
                ms = e.get('ms_played') or 0; k = key_of(a, t); ts = round(end - ms / 1000, 1)
                if (ts, k) in seen: continue
                seen.add((ts, k)); n += 1
                skip = bool(e.get('skipped')) or (e.get('reason_end') in ('fwdbtn',) and ms < 30000)
                f.write(json.dumps(dict(v=1, ts=ts, end=round(end, 1), artist=a, artists=[a], title=t, album=e.get('master_metadata_album_album_name') or '',
                                        key=k, heard=round(ms / 1000, 1), outcome='skip' if skip else 'play', platform=e.get('platform'),
                                        shuffle=e.get('shuffle'), reason_end=e.get('reason_end')), ensure_ascii=False) + '\n')
    print(f'Spotify history: {n} plays imported from {len(files)} file(s)')
    sm = build_summary()
    if sm: print(f"summary: {sm['all']['hours']} h · {sm['all']['plays']} plays · {sm['all']['first']} → {sm['all']['last']} (zarya-journal history)")
    return 0


def build_summary():
    """j3: the whole Spotify history folded into one small file the ДНЕВНИК embeds (per year + all time, Lima time)."""
    p = f'{DIR}/spotify.jsonl'
    if not os.path.exists(p): return None
    Y = collections.defaultdict(lambda: dict(h=0.0, n=0, sk=0, a=collections.Counter(), s=collections.Counter()))
    A = collections.Counter(); S = collections.Counter(); first = last = None
    for ln in open(p, encoding='utf-8'):
        try: r = json.loads(ln)
        except ValueError: continue
        ts = r.get('ts') or 0; y = time.gmtime(ts - 5 * 3600).tm_year; h = r.get('heard') or 0; d = Y[y]
        first = ts if first is None or ts < first else first; last = ts if last is None or ts > last else last
        d['h'] += h; d['n'] += 1; d['a'][r.get('artist') or '?'] += h; A[r.get('artist') or '?'] += h
        if r.get('outcome') == 'skip': d['sk'] += 1
        elif h >= 30: k = (r.get('title') or '?', r.get('artist') or '?'); d['s'][k] += 1; S[k] += 1
    if first is None: return None
    hr = lambda x: round(x / 3600, 1)
    out = dict(built=time.strftime('%F %H:%M'), years=[dict(year=y, hours=hr(d['h']), plays=d['n'], skip=round(100 * d['sk'] / max(1, d['n'])),
               artists=[[a, hr(v)] for a, v in d['a'].most_common(10)], songs=[[t, a, c] for (t, a), c in d['s'].most_common(10)])
               for y, d in sorted(Y.items())],
               all=dict(hours=round(sum(d['h'] for d in Y.values()) / 3600), plays=sum(d['n'] for d in Y.values()),
                        first=time.strftime('%F', time.gmtime(first)), last=time.strftime('%F', time.gmtime(last)),
                        artists=[[a, hr(v)] for a, v in A.most_common(25)], songs=[[t, a, c] for (t, a), c in S.most_common(25)]))
    with open(f'{DIR}/spotify-summary.json.tmp', 'w', encoding='utf-8') as f: json.dump(out, f, ensure_ascii=False)
    os.replace(f'{DIR}/spotify-summary.json.tmp', f'{DIR}/spotify-summary.json')
    return out


def summary_data():
    try: return json.load(open(f'{DIR}/spotify-summary.json', encoding='utf-8'))
    except (OSError, ValueError): return build_summary() if os.path.exists(f'{DIR}/spotify.jsonl') else None


def history():
    sm = summary_data()
    if not sm: print('no Spotify history yet: zarya-journal import ~/Downloads/my_spotify_data.zip'); return 1
    a = sm['all']; print(f"Spotify {a['first']} → {a['last']}: {a['hours']} h · {a['plays']} plays")
    for y in sm['years']:
        print(f"  {y['year']}  {y['hours']:7.0f} h  {y['plays']:6d} plays  skip {y['skip']:2d}%  · " + ', '.join(f'{n} {h:.0f}h' for n, h in y['artists'][:3]))
    print('top artists: ' + ', '.join(f'{n} {h:.0f}h' for n, h in a['artists'][:10]))
    print('top songs:'); [print(f'  {c:5d}×  {t} · {ar}') for t, ar, c in a['songs'][:10]]
    return 0


