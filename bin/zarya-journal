 [[1,'DAY'],[7,'WEEK'],[30,'MONTH'],[3650,'ALL']].forEach(([n,l])=>{const x=document.createElement('button');x.textContent=l;x.className=range==n?'on':'';x.onclick=()=>{range=n;bar();draw()};b.append(x)});
 if(range==1){const s=document.createElement('select');days.forEach(d=>{const o=document.createElement('option');o.value=o.textContent=d;if(d==day)o.selected=true;s.append(o)});s.onchange=()=>{day=s.value;draw()};b.append(s)}
 const c=document.getElementById('srcs');c.innerHTML='<span class="k">sources:</span>';
 [['local','THIS PC (ДЕМОН)'],['lastfm','LAST.FM'],['spotify','SPOTIFY HISTORY']].forEach(([k,l])=>{const n=DATA.filter(r=>r.src==k).length;const x=document.createElement('button');
 x.textContent=`${l} · ${n}`;x.className=src.has(k)?'on':'';x.disabled=!n;x.onclick=()=>{src.has(k)?src.delete(k):src.add(k);if(!src.size)src.add('local');bar();draw()};c.append(x)})}
function pick(){let rs=DATA.filter(r=>src.has(r.src));if(range==1)return rs.filter(r=>dkey(r.ts)==day);const since=Date.now()/1000-range*86400;return rs.filter(r=>r.ts>=since)}
function sessions(rs){const out=[];let cur=null;rs.forEach(r=>{if(!cur||r.ts-cur.end>1200){cur={start:r.ts,end:r.ts,rs:[]};out.push(cur)}cur.rs.push(r);cur.end=Math.max(cur.end,r.end||r.ts+(r.heard||180))});
 out.forEach(s=>{const m={};s.rs.forEach(r=>{if(r.mode)m[r.mode]=(m[r.mode]||0)+(r.heard||0)});const top=Object.entries(m).sort((a,b)=>b[1]-a[1])[0];s.mode=top?top[0]:null;
 const w={};s.rs.forEach(r=>{if(r.weather)w[r.weather]=(w[r.weather]||0)+(r.heard||0)});const tw=Object.entries(w).sort((a,b)=>b[1]-a[1])[0];s.weather=tw?tw[0]:null});return out}
function draw(){const rs=pick(),o=document.getElementById('out');if(!rs.length){o.innerHTML='<div class="empty">Nothing here yet. ДЕМОН writes a line for every song from now on.</div>';return}
 const heard=rs.reduce((a,r)=>a+(r.heard||0),0),sk=rs.filter(r=>r.outcome=='skip').length,likes=rs.filter(r=>r.like).length,hurt=rs.flatMap(r=>r.hurt||[]);
 const cnt={};rs.filter(r=>r.outcome!='skip').forEach(r=>{const k=r.title+' · '+r.artist;cnt[k]=(cnt[k]||0)+1});const top=Object.entries(cnt).sort((a,b)=>b[1]-a[1]).slice(0,10);
 const ac={};rs.forEach(r=>{ac[r.artist]=(ac[r.artist]||0)+(r.heard||0)});const ta=Object.entries(ac).sort((a,b)=>b[1]-a[1]).slice(0,8);
 const mc={};rs.forEach(r=>{if(r.mode)mc[r.mode]=(mc[r.mode]||0)+(r.heard||0)});
 const skipped={};rs.filter(r=>r.outcome=='skip').forEach(r=>{const k=r.title+' · '+r.artist;skipped[k]=(skipped[k]||0)+1});const ts=Object.entries(skipped).sort((a,b)=>b[1]-a[1]).slice(0,6);
 let h='';const wk=(MIND.weeks||[])[0];if(range>1&&wk)h+=`<div class="card wk" style="margin-bottom:12px"><h2>НЕДЕЛЯ · THE WEEK ${esc(wk.week)}</h2><div class="hl">${esc(wk.headline||'')}</div><p>${esc(wk.read)}</p><div class="k" style="margin-top:6px">read by zarya-mind · ${esc(wk.model||'')}</div></div>`;
 h+=`<div class="grid"><div class="card"><h2>СЛУШАЛ</h2><div class="big">${fmt(heard)}</div><div class="k">${rs.length} plays · ${sk} skipped (${Math.round(100*sk/rs.length)}%) · ${likes} ♥</div></div>
 <div class="card"><h2>РЕЖИМЫ</h2>${Object.entries(mc).sort((a,b)=>b[1]-a[1]).slice(0,7).map(([m,s])=>`<span class="tag" style="border-color:${MCOL[m]||'#444'}">${esc(LABEL[m]||m)} ${fmt(s)}</span>`).join('')||'<span class="k">no data</span>'}</div>
 <div class="card"><h2>БОЛЬ</h2>${hurt.length?`<div class="big hurt">${hurt.length}</div><div class="k">${esc([...new Set(hurt)].join(' · '))}</div>`:'<span class="k">he got through untouched</span>'}</div></div>`;
 if(range==1){h+=`<div class="card" style="margin-top:12px"><h2>ДЕНЬ</h2><div class="tl">`+rs.map(r=>{const d=new Date(r.ts*1000);const x=(d.getHours()*3600+d.getMinutes()*60+d.getSeconds())/864;
  const w=Math.max(0.15,(r.heard||60)/864);return `<i class="${r.outcome=='skip'?'skip':''}" title="${esc(r.title)} · ${esc(r.artist)} · ${esc(LABEL[r.mode]||r.mode||'')}" style="left:${x}%;width:${w}%;background:${MCOL[r.mode]||'#3A3450'};border-top:3px solid ${WCOL[r.weather]||'transparent'}"></i>`}).join('')+
  `</div><div class="hours"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div></div>`;
  h+=`<div class="card" style="margin-top:12px"><h2>СЕАНСЫ</h2>`+sessions(rs).map(s=>`<div class="sess" style="border-color:${MCOL[s.mode]||'#7B4DFF'}"><b style="color:var(--bone)">${new Date(s.start*1000).toTimeString().slice(0,5)}–${new Date(s.end*1000).toTimeString().slice(0,5)}</b>
  · a night of ${esc(LABEL[s.mode]||s.mode||'sound')}${s.weather?' · '+esc(LABEL['w_'+s.weather]||s.weather):''} · ${s.rs.length} songs · <span class="k">${esc([...new Set(s.rs.map(r=>r.artist))].slice(0,4).join(', '))}</span></div>`).join('')+`</div>`}
 else{const heat=Array.from({length:7},()=>Array(24).fill(0));rs.forEach(r=>{const d=new Date(r.ts*1000);heat[(d.getDay()+6)%7][d.getHours()]+=(r.heard||0)});const mx=Math.max(1,...heat.flat());
  h+=`<div class="card" style="margin-top:12px"><h2>КОГДА</h2><div class="heat">`+['MON','TUE','WED','THU','FRI','SAT','SUN'].map((l,i)=>`<div class="lab">${l}</div>`+heat[i].map(v=>`<div style="background:rgba(123,77,255,${(v/mx).toFixed(2)})" title="${fmt(v)}"></div>`).join('')).join('')+`</div></div>`}
 h+=`<div class="grid" style="margin-top:12px"><div class="card"><h2>ПЕСНИ</h2><ol>${top.map(([k,n])=>`<li><b>${esc(k)}</b> <span class="k">${n}×</span></li>`).join('')}</ol></div>
 <div class="card"><h2>АРТИСТЫ</h2><ol>${ta.map(([a,s])=>`<li><b>${esc(a)}</b> <span class="k">${fmt(s)}</span></li>`).join('')}</ol></div>
 <div class="card"><h2>ПРОПУЩЕНО</h2>${ts.length?`<ol>${ts.map(([k,n])=>`<li>${esc(k)} <span class="k">${n}×</span></li>`).join('')}</ol>`:'<span class="k">no skips</span>'}</div></div>`;
 h+=`<div class="card" style="margin-top:12px"><h2>ЖУРНАЛ</h2><table><tr><th>TIME</th><th>SONG</th><th>HEARD</th><th>HOW HE READ IT</th><th>WHAT HAPPENED</th></tr>`+rs.slice().reverse().slice(0,300).map(r=>{const d=new Date(r.ts*1000);
  return `<tr><td class="k">${range==1?d.toTimeString().slice(0,5):dkey(r.ts).slice(5)+' '+d.toTimeString().slice(0,5)}</td><td><b style="color:var(--bone)">${esc(r.title)}</b><br><span class="k">${esc(r.artist)}${r.src!='local'?' · '+r.src:''}</span>${r.about?`<div class="about">${esc(r.about)}</div>`:''}${(r.mood||[]).length?`<div class="mood">${esc(r.mood.join(' · '))}${r.dark?' · <span class="dark">dark core</span>':''}</div>`:''}</td>
  <td>${fmt(r.heard)}${r.outcome=='skip'?' <span class="tag">SKIP</span>':r.outcome=='finish'?'':''}${r.replay?' <span class="tag">REPLAY</span>':''}${r.like?' ♥':''}</td>
  <td>${r.mode?`<span class="tag" style="border-color:${MCOL[r.mode]||'#444'}">${esc(LABEL[r.mode]||r.mode)}</span>`:''}${r.weather?`<span class="tag" style="border-color:${WCOL[r.weather]}">${esc(LABEL['w_'+r.weather]||r.weather)}</span>`:''}<br><span class="k">${esc(r.why||'')}</span></td>
  <td>${(r.peaks||[]).map(p=>esc(p.replace(/^peak: /,''))).slice(0,3).join('<br>')}${(r.hurt||[]).length?`<br><span class="hurt">${esc(r.hurt.join(' · '))}</span>`:''}${r.report?'<br><span class="tag">REPORT</span>':''}</td></tr>`}).join('')+`</table></div>`;
 o.innerHTML=h}
function hist(){const o=document.getElementById('hist');if(!HIST){o.innerHTML='';return}const a=HIST.all,mx=Math.max(...HIST.years.map(y=>y.hours));
 let h=`<div class="card" style="margin-top:22px"><h2>С 2020 · SINCE ${esc(a.first.slice(0,4))}</h2><div class="big">${a.hours} h</div><div class="k">${a.plays} plays · Spotify history ${esc(a.first)} → ${esc(a.last)} · single plays above cover the last ${RECENT} days</div>
 <table style="margin-top:10px"><tr><th>YEAR</th><th>HOURS</th><th></th><th>SKIP</th><th>TOP ARTISTS</th></tr>`+HIST.years.map(y=>`<tr><td><b style="color:var(--bone)">${y.year}</b></td><td>${Math.round(y.hours)}</td>
 <td style="width:30%"><div style="height:10px;background:var(--v);width:${(100*y.hours/mx).toFixed(1)}%"></div></td><td class="k">${y.skip}%</td><td>${y.artists.slice(0,3).map(([n,v])=>`${esc(n)} <span class="k">${Math.round(v)}h</span>`).join(' · ')}</td></tr>`).join('')+`</table></div>
 <div class="grid" style="margin-top:12px"><div class="card"><h2>АРТИСТЫ · ALL TIME</h2><ol>${a.artists.slice(0,15).map(([n,v])=>`<li><b>${esc(n)}</b> <span class="k">${Math.round(v)}h</span></li>`).join('')}</ol></div>
 <div class="card"><h2>ПЕСНИ · ALL TIME</h2><ol>${a.songs.slice(0,15).map(([t,ar,c])=>`<li><b>${esc(t)}</b> <span class="k">${esc(ar)} · ${c}×</span></li>`).join('')}</ol></div>
 <div class="card"><h2>ПО ГОДАМ · BY YEAR</h2><select id="hy">${HIST.years.slice().reverse().map(y=>`<option>${y.year}</option>`).join('')}</select><ol id="hyl" style="margin-top:8px"></ol></div></div>`;
 o.innerHTML=h;const s=document.getElementById('hy'),f=()=>{const y=HIST.years.find(y=>y.year==s.value);document.getElementById('hyl').innerHTML=y.songs.map(([t,ar,c])=>`<li><b>${esc(t)}</b> <span class="k">${esc(ar)} · ${c}×</span></li>`).join('')};s.onchange=f;f()}
const RECENT=__RECENT__;
bar();draw();hist();
</script></body></html>'''
LABELS = dict(brk='БРЕЙК', liquid='БРЕЙК · ЖИДКИЙ', jungle='БРЕЙК · ДЖАНГЛ', memory='ПАМЯТЬ', nod='КИВОК', mosh='МОШ', kendrick='КЕНДРИК', grips='РАСПАД',
              groove='ГРУВ', epic='ЭПОС', kawaii='КАВАЙ', rest='ПРИВАЛ', drive='ТРАССА', bolero='БОЛЕРО', run='БЕГ', hum='НАПЕВ', w_rain='ДОЖДЬ',
              w_clear='ЯСНО', w_storm='ГРОЗА', w_dawn='РАССВЕТ', changeling='ПОДМЕНЫШ'); LABELS['break'] = 'БРЕЙК'


def mind_data():
    """j4: zarya-mind's cache: {'songs': {key: reading}, 'weeks': [newest first]}. Empty when zarya-mind never ran."""
    base = f'{HOME}/.local/share/zarya/mind'; songs = {}; weeks = []
    for p in glob.glob(f'{base}/songs/*.json'):
        try: j = json.load(open(p, encoding='utf-8'))
        except (OSError, ValueError): continue
        if j.get('key'): songs[j['key']] = {k: j.get(k) for k in ('about', 'mood', 'dark_core')}
    for p in sorted(glob.glob(f'{base}/weeks/*.json'), reverse=True):
        try: weeks.append(json.load(open(p, encoding='utf-8')))
        except (OSError, ValueError): pass
    return dict(songs=songs, weeks=weeks)


def diary(open_it=True):
    c = conf()
    if c.get('lastfm_user'):
        try: lastfm_sync(c['lastfm_user'])
        except Exception as e: print(f'Last.fm sync skipped: {e}')
    rs = plays(src=('local', 'lastfm')) + plays(days=RECENT_DAYS, src=('spotify',))       # j3: older Spotify = summary only
    rs.sort(key=lambda r: r.get('ts', 0))
    slim = [{k: r.get(k) for k in ('ts', 'end', 'artist', 'title', 'heard', 'outcome', 'replay', 'like', 'mode', 'weather', 'why', 'peaks', 'hurt', 'report', 'src')} for r in rs]
    mind = mind_data()                                                                     # j4: zarya-mind readings
    for r in slim:
        m = mind['songs'].get(key_of(r.get('artist'), r.get('title')))
        if m: r['about'], r['mood'], r['dark'] = m.get('about'), m.get('mood') or [], bool(m.get('dark_core'))
    html = PAGE.replace('__DATA__', json.dumps(slim, ensure_ascii=False).replace('</', '<\\/')).replace('__LABEL__', json.dumps(LABELS, ensure_ascii=False)) \
               .replace('__BUILT__', time.strftime('%F %H:%M')).replace('__RECENT__', str(RECENT_DAYS)) \
               .replace('__HIST__', json.dumps(summary_data(), ensure_ascii=False).replace('</', '<\\/')) \
               .replace('__MIND__', json.dumps(dict(weeks=mind['weeks'][:4]), ensure_ascii=False).replace('</', '<\\/'))
    os.makedirs(DIR, exist_ok=True); out = f'{DIR}/dnevnik.html'
    with open(out, 'w', encoding='utf-8') as f: f.write(html)
    print(f'ДНЕВНИК: {len(rs)} plays → {out}')
    if open_it: subprocess.Popen(['xdg-open', out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return out


def cli():
    a = sys.argv[1:]; cmd = a[0] if a else 'today'
    if cmd in ('-h', '--help', 'help'): print(open(__file__).read().split('\nimport ', 1)[0].replace('# ', '')); return 0
    if cmd == 'today':
        t0 = time.mktime(time.strptime(time.strftime('%F'), '%Y-%m-%d'))
        summary([r for r in plays(days=1) if r['ts'] >= t0], 'today'); return 0
    if cmd == 'week': summary(plays(days=7), 'last 7 days'); return 0
    if cmd == 'top': d = float(a[1]) if len(a) > 1 else 30; summary(plays(days=d), f'last {d:g} days'); return 0
    if cmd == 'diary': diary('--no-open' not in a); return 0
    if cmd == 'ask':
        cnt = collections.Counter(); why = {}
        for r in plays(days=60):
            if r.get('outcome') != 'skip': cnt[r['key']] += 1; why[r['key']] = (r.get('why'), r['title'], r['artist'])
        ak = asked().get('songs', {})
        rows = [(n, why[k]) for k, n in cnt.most_common() if n >= 3 and k not in ak and why[k][0] in ('the sound', 'listening…', None)]
        print('\n'.join(f'  {n}×  {t} · {ar}' for n, (w, t, ar) in rows) or 'nothing to ask: every song you repeat already has a reading.'); return 0
    if cmd == 'lastfm':
        user = a[1] if len(a) > 1 else conf().get('lastfm_user')
        if not user: print('usage: zarya-journal lastfm USER  (saved for next time)'); return 1
        if conf().get('lastfm_user') != user:
            os.makedirs(os.path.dirname(CONF), exist_ok=True)
            lines = [l for l in (open(CONF).read().splitlines() if os.path.exists(CONF) else []) if not l.startswith('lastfm_user')]
            open(CONF, 'w').write('\n'.join(lines + [f'lastfm_user={user}']) + '\n')
        return lastfm_sync(user)
    if cmd == 'history': return history()                              # j3
    if cmd == 'import':
        if len(a) < 2: print('usage: zarya-journal import ~/Downloads/my_spotify_data.zip'); return 1
        return spotify_import(os.path.expanduser(a[1]))
    if cmd == 'export':
        import tarfile
        out = f'{HOME}/Downloads/demon-journal-{time.strftime("%Y%m%d-%H%M")}.tar.gz'
        with tarfile.open(out, 'w:gz') as t:
            if os.path.isdir(DIR): t.add(DIR, arcname='listening', filter=lambda ti: None if ti.name.endswith('dnevnik.html') else ti)
            rp = f'{HOME}/.local/share/zarya/reports'
            if os.path.isdir(rp): t.add(rp, arcname='reports')
            mp = f'{HOME}/.local/share/zarya/demon/memory.json'
            if os.path.exists(mp): t.add(mp, arcname='memory.json')
        print(out); return 0
    if cmd == 'path': print(DIR); return 0
    print('commands: today · week · top [DAYS] · diary · ask · lastfm USER · import PATH · history · export · path'); return 1


if __name__ == '__main__':
    sys.exit(cli())
